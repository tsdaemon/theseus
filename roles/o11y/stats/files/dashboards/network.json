{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Network path probes from Theseus (router, provider, internet) and router state over SNMP and syslog.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fault location",
      "description": "WAN path: first failing stage Theseus → router → provider (ISP first hop) → internet. Wi-Fi: lossy while the router is clean, or down while the router is up.",
      "datasource": {
        "type": "prometheus",
        "uid": "ansible_nas"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ansible_nas"
          },
          "editorMode": "code",
          "expr": "vector((1 - scalar(max(network_probe_success{target=\"router\"}))) * 3 + scalar(max(network_probe_success{target=\"router\"})) * (1 - scalar(max(network_probe_success{target=\"provider\"}) or vector(1))) * 2 + scalar(max(network_probe_success{target=\"router\"})) * scalar(max(network_probe_success{target=\"provider\"}) or vector(1)) * (1 - scalar(max(network_probe_success{target=\"internet\"}) or vector(1))) * 1)",
          "legendFormat": "WAN path",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ansible_nas"
          },
          "editorMode": "code",
          "expr": "vector(scalar(max(network_probe_success{target=\"router\"})) * (1 - scalar(max(network_probe_success{target=\"wifi\"}) or vector(1))) * 2 + scalar(max(network_probe_success{target=\"router\"})) * scalar(max(network_probe_success{target=\"wifi\"}) or vector(1)) * (scalar(max(network_packet_loss_ratio{target=\"wifi\",window=\"1m\"}) > bool 0 or vector(0)) * (1 - scalar(max(network_packet_loss_ratio{target=\"router\",window=\"1m\"}) > bool 0 or vector(0)))))",
          "legendFormat": "Wi-Fi",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "ISP upstream",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "Router WAN / ISP access",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "Router / LAN",
                  "color": "dark-red",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Wi-Fi"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Wi-Fi lossy",
                        "color": "yellow",
                        "index": 1
                      },
                      "2": {
                        "text": "Wi-Fi down",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Path status by target",
      "description": "Down: no replies in a probe window. Lossy: some loss over the last minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "ansible_nas"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 5,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ansible_nas"
          },
          "editorMode": "code",
          "expr": "network_probe_success * on (target) (2 - (network_packet_loss_ratio{window=\"1m\"} > bool 0))",
          "legendFormat": "{{target}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Lossy",
                  "color": "yellow",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "OK",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
