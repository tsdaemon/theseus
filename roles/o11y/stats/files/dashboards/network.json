  },
  "description": "Network path probes from Theseus: router, provider (ISP first hop), internet.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Fault location",
      "description": "WAN path: first failing stage Theseus → router → provider (ISP first hop) → internet. Wi-Fi: lossy while the router is clean, or down while the router is up.",
      "datasource": {
        "type": "prometheus",
        "uid": "ansible_nas"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ansible_nas"
          },
          "editorMode": "code",
          "expr": "vector((1 - scalar(max(network_probe_success{target=\"router\"}))) * 3 + scalar(max(network_probe_success{target=\"router\"})) * (1 - scalar(max(network_probe_success{target=\"provider\"}) or vector(1))) * 2 + scalar(max(network_probe_success{target=\"router\"})) * scalar(max(network_probe_success{target=\"provider\"}) or vector(1)) * (1 - scalar(max(network_probe_success{target=\"internet\"}) or vector(1))) * 1)",
          "legendFormat": "WAN path",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ansible_nas"
          },
          "editorMode": "code",
          "expr": "vector(scalar(max(network_probe_success{target=\"router\"})) * (1 - scalar(max(network_probe_success{target=\"wifi\"}) or vector(1))) * 2 + scalar(max(network_probe_success{target=\"router\"})) * scalar(max(network_probe_success{target=\"wifi\"}) or vector(1)) * (scalar(max(network_packet_loss_ratio{target=\"wifi\",window=\"1m\"}) > bool 0 or vector(0)) * (1 - scalar(max(network_packet_loss_ratio{target=\"router\",window=\"1m\"}) > bool 0 or vector(0)))))",
          "legendFormat": "Wi-Fi",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "ISP upstream",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "Router WAN / ISP access",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "Router / LAN",
                  "color": "dark-red",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Wi-Fi"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Wi-Fi lossy",
                        "color": "yellow",
                        "index": 1
                      },
                      "2": {
                        "text": "Wi-Fi down",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.9,
        "alignValue": "left",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Path status by target",
      "description": "Down: no replies in a probe window. Lossy: some loss over the last minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "ansible_nas"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ansible_nas"
          },
          "editorMode": "code",
          "expr": "network_probe_success * on (target) (2 - (network_packet_loss_ratio{window=\"1m\"} > bool 0))",
          "legendFormat": "{{target}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Lossy",
                  "color": "yellow",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "OK",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.9,
        "alignValue": "left",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
