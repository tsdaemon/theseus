# Managed by Ansible (roles/configuration/disk)
[Service]
ExecStartPre=+/bin/sh -c 'mkdir -p "$(dirname {{ hddfancontrol_hwmon_link }})"; for h in /sys/class/hwmon/hwmon*; do [ "$(cat $h/name)" = "{{ hddfancontrol_hwmon_name }}" ] && exec ln -sfn "$(readlink -f $h)" {{ hddfancontrol_hwmon_link }}; done; echo "hwmon {{ hddfancontrol_hwmon_name }} not found" >&2; exit 1'
